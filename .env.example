# ─────────────────────────────────────────────────────────────────────────────
# Nazareth Parish ChMS — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the application (used in emails/links)
APP_URL=http://localhost:3000
# Port for the web server (also hosts the REST API)
PORT=3000
# Secret used to sign CSRF double-submit tokens. Generate with:
#   openssl rand -hex 32
CSRF_SECRET=change-me-64-hex-chars

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://nazareth:nazareth@localhost:5432/nazareth?schema=public
# Separate database used by the test-suite
DATABASE_URL_TEST=postgresql://nazareth:nazareth@localhost:5432/nazareth_test?schema=public

# ── Sessions ─────────────────────────────────────────────────────────────────
# Cookie name is fixed (chms_session); expiry is configurable here.
# 24h sliding idle expiry
SESSION_IDLE_MINUTES=1440
# "remember me" lifetime
SESSION_REMEMBER_DAYS=30

# ── Email (provider abstraction — see docs/ARCHITECTURE.md ADR-006) ─────────
# MAIL_PROVIDER=console            # console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Nazareth Parish <office@nazareth.example>"

# ── SMS (future provider integration — dev provider logs to dev outbox) ──────
# SMS_PROVIDER=log
# SMS_PROVIDER_KEY=

# ── File storage ─────────────────────────────────────────────────────────────
FILE_STORAGE_PATH=.data/files
FILE_MAX_SIZE_MB=8
# Allowed upload types (comma separated)
FILE_ALLOWED_MIMES=image/png,image/jpeg,image/webp,application/pdf

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_PATH=.data/backups
# number of dumps to keep
BACKUP_RETENTION=7
# daily backup hour (server time)
BACKUP_HOUR=2

# ── Follow-up / absence detection ────────────────────────────────────────────
ABSENCE_WEEKS_SHORT=2
ABSENCE_WEEKS_MEDIUM=4
ABSENCE_WEEKS_LONG=8
